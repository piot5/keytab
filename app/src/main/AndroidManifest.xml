<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dateimanager-Tab + eigenes Hintergrundbild — bewusst minimal gehalten
         (Feature → Permission):
         - READ_EXTERNAL_STORAGE: Dateibrowser auf Android ≤ 12 (API 24–32).
         - READ_MEDIA_IMAGES: Bilder browsen + Hintergrundbild der Themen-
           Einstellungen decodieren (Android 13+).
         - READ_MEDIA_AUDIO/READ_MEDIA_VIDEO wurden am 2026-09-22 entfernt: kein
           Codepfad liest Audio- oder Videodaten; für den Dateibrowser genügt der
           Name/Pfad einer Datei. Nicht lesbare Medien zeigen weiter den
           "fm_no_storage_access"-Hinweis.
         - MANAGE_EXTERNAL_STORAGE: bewusst nicht (Play-/F-Droid-Blocker, viel zu
           breit) — siehe Roadmap. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Android 14+: selected-photo access is the least-privilege image picker. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.KeyTab">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ThemeSettingsActivity"
            android:exported="false"
            android:label="@string/theme_settings_title" />

        <service
            android:name=".ime.KeyTabImeService"
            android:exported="true"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
