<?xml version="1.0" encoding="utf-8"?>
<!-- Tab-Hintergrund FLACH und ECKIG, ohne Insets:
     - keine abgerundeten Ecken (Tabs sitzen nicht mehr auf „grauen Rundfeldern")
     - keine seitlichen/vertikalen Insets → keine Lücken links/rechts der Tab-Zellen,
       jede Zelle ist komplett ausgefüllt
     Früher: tab_bg_inset (key_bg mit 8dp-Rundung + 4dp/3dp-Inset). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/key_pressed" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/key_bg" />
        </shape>
    </item>
</selector>
