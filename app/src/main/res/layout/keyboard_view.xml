<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kbd_bg"
    android:paddingTop="0dp"
    android:paddingBottom="4dp">

    <!-- Tab-Leiste: Dark/Light-Umschalter | abc/Notes/Files/Terminal | Einstellungen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/kbd_bg"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="0dp">

        <Button
            android:id="@+id/key_theme"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:layout_weight="0"
            android:layout_marginTop="0dp"
            android:layout_gravity="center_vertical"
            android:background="@color/key_bg"
            android:textSize="14sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="☾" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/ime_tabs"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabPaddingStart="4dp"
            app:tabPaddingEnd="4dp"
            app:tabTextAppearance="@style/KeyTabSmallTabText"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabSelectedTextColor="@color/text_primary"
            app:tabTextColor="@color/tab_text"
            app:tabBackground="@android:color/transparent">
            <!-- tabBackground MUSS transparent sein (nicht tab_bg_flat!):
                 Material's TabLayout.onDraw zeichnet dieses Drawable als
                 baseBackgroundDrawable UNTER jedem TabView – zusätzlich und
                 unabhängig von View.background. Ein opakes tab_bg_flat dort
                 ließ die obere Zeile (ABC/Notes/Files) immer in der Basisfarbe
                 bleiben: Der Theme-Verlauf schien nicht durch, und der Alpha-
                 Regler der Tastenfarbe wirkte dort nicht. Die sichtbare
                 Zellen-Farbe kommt ausschließlich vom ime_tabs-Block in
                 ThemeApplier.apply(): TabLayout + SlidingTabIndicator werden
                 TRANSPARENT, jeder TabView bekommt flatKeyState() (flach, eckig,
                 Theme-Farbe inkl. Alpha), das Ripple-Foreground wird gelöscht. -->


            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_letters" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_editor_short" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_files" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_clip_short" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_term_short" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_snip_short" />
        </com.google.android.material.tabs.TabLayout>

        <Button
            android:id="@+id/key_settings"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:layout_weight="0"
            android:layout_marginTop="0dp"
            android:layout_gravity="center_vertical"
            android:background="@color/key_bg"
            android:textSize="16sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="☰" />
    </LinearLayout>

    <!-- Notes-Panel ÜBER den Buchstaben (nur im Notes-Tab sichtbar):
         Editor mit Load/Save + integrierter Clipboard-Historie (Ablage) -->
    <LinearLayout
        android:id="@+id/editor_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Load/Save-Zeile: Buttons im abc-Tastatur-Look (KeyDark) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/key_bg">

            <Button
                android:id="@+id/btn_editor_load"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="48dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:text="@string/editor_load" />

            <Button
                android:id="@+id/btn_editor_save"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="48dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:textSize="13sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:text="@string/editor_save" />

            <!-- ↑ Editor-Inhalt direkt ins App-Feld darüber einfügen -->
            <Button
                android:id="@+id/btn_editor_send_up"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="40dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:text="@string/editor_send_up" />

            <!-- ✕ Editor leeren -->
            <Button
                android:id="@+id/btn_editor_clear"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="40dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:text="@string/editor_clear" />

            <!-- ⎘ Editor-Inhalt ins System-Clipboard kopieren -->
            <Button
                android:id="@+id/btn_editor_copy"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="40dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:text="@string/editor_copy" />

            <!-- ↻ Datei neu laden -->
            <Button
                android:id="@+id/btn_editor_reload"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="40dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="3dp"
                android:textSize="14sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:text="@string/editor_reload" />

            <TextView
                android:id="@+id/editor_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="start"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:padding="4dp" />
        </LinearLayout>

        <!-- Editorfeld mit Zeilennummern-Gutter: gleiche Schrift (monospace, 13sp)
             und gleiche Polsterung (8dp oben) wie das Feld, damit die Zeilenhöhen
             exakt übereinstimmen; EditorPanel synchronisiert den vertikalen Scroll. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editor_gutter"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="34dp"
                android:gravity="top|end"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textColor="@color/editor_gutter_text"
                android:background="@color/editor_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="8dp" />

            <EditText
                android:id="@+id/editor_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:background="@color/editor_bg"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:hint="@string/editor_hint"
                android:padding="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Clipboard-Panel (nur im Clip-Tab sichtbar):
         Historie der kopierten Texte, tippen = in Zielfeld einfügen -->
    <LinearLayout
        android:id="@+id/clip_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/key_bg">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/clip_tab_hint"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:padding="4dp" />

            <Button
                android:id="@+id/btn_clip_clear"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="48dp"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:text="@string/clip_clear" />
        </LinearLayout>

        <ListView
            android:id="@+id/clip_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/list_bg" />
    </LinearLayout>

    <!-- Snippets ÜBER den Buchstaben (nur im Snip-Tab sichtbar):
         benannte Befehle/Snippets aus keytab_snippets.txt (Format: name = text),
         Tap = einfügen. Höhe wird beim Tab-Wechsel an Editor+Tastatur
         angeglichen (PanelHeights), wie Files/Clip/Terminal. -->
    <LinearLayout
        android:id="@+id/snippet_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:textSize="10sp"
            android:textColor="@color/text_secondary"
            android:text="@string/snippet_hint_empty" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/snip_add"
                style="@style/KeyEditorBar"
                android:layout_marginStart="4dp"
                android:text="@string/snip_add" />

            <Button
                android:id="@+id/snip_edit"
                style="@style/KeyEditorBar"
                android:layout_marginStart="4dp"
                android:text="@string/snip_edit" />
        </LinearLayout>

        <ListView
            android:id="@+id/snippet_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/list_bg" />
    </LinearLayout>

    <!-- Terminal ÜBER den Buchstaben (nur im Terminal-Tab sichtbar):
         Ausgabeverlauf (interaktive Shell) + Eingabezeile darunter -->
    <LinearLayout
        android:id="@+id/term_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/term_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/term_bg"
            android:fillViewport="true">

            <TextView
                android:id="@+id/term_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="@color/term_text"
                android:padding="4dp"
                android:textIsSelectable="false" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/term_bg">

            <EditText
                android:id="@+id/terminal_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:inputType="textNoSuggestions"
                android:background="@color/term_bg"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="@color/term_text"
                android:hint="@string/terminal_hint"
                android:textColorHint="@color/term_prompt"
                android:padding="6dp" />

            <Button
                android:id="@+id/btn_term_send"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_weight="0"
                android:minWidth="56dp"
                android:textSize="12sp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="0dp"
                android:text="@string/terminal_send" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/kb_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp">
        <!-- marginTop 3dp (vorher 6dp): geringer Abstand zwischen Tab-Leiste und
             der ersten Zeile im abc-Tab (Wortvorhersage bzw. Q-Reihe). -->

        <!-- Buchstaben-Tastatur -->
        <!-- Buchstaben-Tastatur (Rows in panel_keyboard_letters.xml) -->
        <LinearLayout
            android:id="@+id/kb_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/panel_keyboard_letters" />
        </LinearLayout>

        <!-- Sonderzeichen-Ebene (Rows in panel_keyboard_symbols.xml) -->
        <LinearLayout
            android:id="@+id/sym_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <include layout="@layout/panel_keyboard_symbols" />
        </LinearLayout>

        <!-- Dateimanager: feste Höhe → Unterkante bündig mit der Enter-Zeile -->
        <LinearLayout
            android:id="@+id/file_panel"
            android:layout_width="match_parent"
            android:layout_height="164dp"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header: kompakte Buttons – konsistent zum Editor-Header (minWidth 48dp, 13sp).
                 Zurück/Hoch getauscht (▲ zurück, ‹ hoch) – visuell linksgebündelt. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/key_bg">

                <Button
                    android:id="@+id/btn_back_dir"
                    style="@style/KeyDark"
                    android:layout_width="wrap_content"
                    android:layout_weight="0"
                    android:minWidth="48dp"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="1dp"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="0dp"
                    android:text="@string/btn_up_label"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_up_dir"
                    style="@style/KeyDark"
                    android:layout_width="wrap_content"
                    android:layout_weight="0"
                    android:minWidth="48dp"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="1dp"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="0dp"
                    android:text="@string/btn_back_label"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_paste_dir"
                    style="@style/KeyDark"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_margin="1dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textSize="12sp"
                    android:text="@string/fm_paste"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/file_dir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="start"
                    android:textSize="12sp"
                    android:textColor="@color/text_primary"
                    android:padding="4dp" />
            </LinearLayout>

            <ListView
                android:id="@+id/file_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/list_bg" />

            <TextView
                android:id="@+id/file_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Gemeinsame Funktionsleiste: ?123 / Space / Enter (nur bei abc/Notes sichtbar) -->
    <LinearLayout
        android:id="@+id/bottom_row"
        style="@style/KeyRow"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="4dp">
        <!-- marginTop 0dp (vorher 4dp): geringer Abstand über der Enter-Zeile
             (Y-Reihe-Key-Margin 2dp + Key-Margin 2dp = 4dp statt vorher 8dp). -->
        <Button style="@style/KeyDark" android:id="@+id/key_toggle" android:text="\?123"
            android:textSize="16sp" />
        <Button style="@style/KeyDark" android:id="@+id/key_tab" android:text="⇥"
            android:layout_width="34dp" android:layout_weight="0" />
        <Button style="@style/KeyDark" android:id="@+id/key_space" android:text="@string/key_space_label"
            android:layout_weight="3" />
        <Button style="@style/KeyDark" android:id="@+id/key_dot" android:text="."
            android:layout_width="34dp" android:layout_weight="0" />
        <!-- Enter-Taste breiter: bekommt eigene Gewichtung statt Fix-Breite (besser drückbar) -->
        <Button style="@style/KeyDark" android:id="@+id/key_enter" android:text="@string/key_enter_label"
            android:layout_width="0dp" android:layout_weight="2" />
    </LinearLayout>
</LinearLayout>
