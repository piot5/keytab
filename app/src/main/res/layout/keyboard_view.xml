<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/kbd_bg"
    android:paddingTop="0dp"
    android:paddingBottom="4dp">

    <!-- Tab-Leiste: Dark/Light-Umschalter | abc/Notes/Files/Terminal | Einstellungen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/kbd_bg"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:paddingTop="0dp">

        <Button
            android:id="@+id/key_theme"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:layout_weight="0"
            android:layout_marginTop="0dp"
            android:layout_gravity="center_vertical"
            android:background="@color/key_bg"
            android:textSize="14sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="☾" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/ime_tabs"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabPaddingStart="10dp"
            app:tabPaddingEnd="10dp"
            app:tabTextAppearance="@style/KeyTabSmallTabText"
            app:tabIndicatorColor="@android:color/transparent"
            app:tabIndicatorHeight="0dp"
            app:tabSelectedTextColor="@color/text_primary"
            app:tabTextColor="@color/tab_text"
            app:tabBackground="@drawable/tab_bg_inset">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_letters" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_editor_short" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_files" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ime_tab_term_short" />
        </com.google.android.material.tabs.TabLayout>

        <Button
            android:id="@+id/key_settings"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:layout_weight="0"
            android:layout_marginTop="0dp"
            android:layout_gravity="center_vertical"
            android:background="@color/key_bg"
            android:textSize="20sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            android:text="⚙" />
    </LinearLayout>

    <!-- Notes-Panel ÜBER den Buchstaben (nur im Notes-Tab sichtbar):
         Editor mit Load/Save + integrierter Clipboard-Historie (Ablage) -->
    <LinearLayout
        android:id="@+id/editor_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Load/Save-Zeile: deutlich flacher (26dp statt 42dp) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/key_bg">

            <Button
                android:id="@+id/btn_editor_load"
                style="@style/KeyEditorBar"
                android:text="@string/editor_load" />

            <Button
                android:id="@+id/btn_editor_save"
                style="@style/KeyEditorBar"
                android:text="@string/editor_save" />

            <TextView
                android:id="@+id/editor_file"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="start"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:padding="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/editor_input"
            android:layout_width="match_parent"
            android:layout_height="130dp"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:background="@color/editor_bg"
            android:textColor="@color/text_primary"
            android:hint="@string/editor_hint"
            android:padding="8dp" />

        <!-- Clipboard-Historie (ehem. eigener Ablage-Tab) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/key_bg">

            <Button
                android:id="@+id/btn_clip_add"
                style="@style/KeyEditorBar"
                android:text="@string/clip_add" />

            <Button
                android:id="@+id/btn_clip_clear"
                style="@style/KeyEditorBar"
                android:text="@string/clip_clear" />

            <TextView
                android:id="@+id/clip_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:padding="4dp" />
        </LinearLayout>

        <ListView
            android:id="@+id/clip_list"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:background="@color/list_bg" />
    </LinearLayout>

    <!-- Terminal ÜBER den Buchstaben (nur im Terminal-Tab sichtbar):
         Ausgabeverlauf (interaktive Shell) + Eingabezeile darunter -->
    <LinearLayout
        android:id="@+id/term_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/term_scroll"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@color/editor_bg"
            android:fillViewport="true">

            <TextView
                android:id="@+id/term_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:padding="6dp"
                android:textIsSelectable="false" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/key_bg">

            <EditText
                android:id="@+id/terminal_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:inputType="textNoSuggestions"
                android:background="@color/editor_bg"
                android:textColor="@color/text_primary"
                android:hint="@string/terminal_hint"
                android:padding="8dp" />

            <Button
                android:id="@+id/btn_term_send"
                style="@style/KeyDark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/terminal_send" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/kb_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <!-- Buchstaben-Tastatur -->
        <LinearLayout
            android:id="@+id/kb_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Wortvorhersage: 3 Kandidaten, antippbar (leert = ausgeblendet).
                 sug_1 (höchste Wahrscheinlichkeit) = 2x breiter + bold + hervorgehoben. -->
            <LinearLayout
                android:id="@+id/suggestion_bar"
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:background="@color/kbd_bg">

                <TextView
                    android:id="@+id/sug_1"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="2" android:gravity="center"
                    android:singleLine="true" android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" android:clickable="true"
                    android:focusable="true" android:background="@drawable/sug_top_bg" />
                <TextView
                    android:id="@+id/sug_2"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center"
                    android:singleLine="true" android:textSize="13sp"
                    android:textColor="@color/text_primary" android:clickable="true"
                    android:focusable="true" android:background="@color/key_bg"
                    android:layout_marginStart="2dp" />
                <TextView
                    android:id="@+id/sug_3"
                    android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:gravity="center"
                    android:singleLine="true" android:textSize="13sp"
                    android:textColor="@color/text_primary" android:clickable="true"
                    android:focusable="true" android:background="@color/key_bg"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- Optionale Zahlenreihe (Einstellung in der App) -->
            <LinearLayout
                android:id="@+id/num_row"
                style="@style/KeyRow"
                android:visibility="gone">
                <Button style="@style/KeyDark" android:tag="sym" android:text="1" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="2" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="3" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="4" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="5" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="6" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="7" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="8" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="9" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="0" />
            </LinearLayout>

            <LinearLayout style="@style/KeyRow">
                <Button style="@style/KeyDark" android:tag="letter" android:text="q" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="w" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="e" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="r" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="t" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="z" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="u" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="i" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="o" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="p" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="ü" />
            </LinearLayout>

            <LinearLayout style="@style/KeyRow">
                <Button style="@style/KeyDark" android:tag="letter" android:text="a" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="s" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="d" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="f" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="g" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="h" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="j" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="k" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="l" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="ö" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="ä" />
            </LinearLayout>

            <LinearLayout style="@style/KeyRow">
                <Button style="@style/KeyDark" android:id="@+id/key_shift" android:text="@string/key_shift_label" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="y" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="x" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="c" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="v" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="b" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="n" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="m" />
                <Button style="@style/KeyDark" android:tag="letter" android:text="ß" />
                <Button style="@style/KeyDark" android:id="@+id/key_del" android:text="@string/key_del_label" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sonderzeichen-Ebene (über die ?123-Taste) -->
        <LinearLayout
            android:id="@+id/sym_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/KeyRow">
                <Button style="@style/KeyDark" android:tag="sym" android:text="1" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="2" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="3" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="4" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="5" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="6" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="7" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="8" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="9" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="0" />
            </LinearLayout>

            <LinearLayout style="@style/KeyRow">
                <Button style="@style/KeyDark" android:tag="sym" android:text="-" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="/" />
                <Button style="@style/KeyDark" android:tag="sym" android:text=":" />
                <Button style="@style/KeyDark" android:tag="sym" android:text=";" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="(" />
                <Button style="@style/KeyDark" android:tag="sym" android:text=")" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="$" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="@" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="&amp;" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="%" />
            </LinearLayout>

            <LinearLayout style="@style/KeyRow">
                <Button style="@style/KeyDark" android:tag="sym" android:text="." />
                <Button style="@style/KeyDark" android:tag="sym" android:text="," />
                <Button style="@style/KeyDark" android:tag="sym" android:text="?" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="!" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="=" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="+" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="*" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="_" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="&quot;" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="'" />
            </LinearLayout>

            <LinearLayout style="@style/KeyRow">
                <Button style="@style/KeyDark" android:tag="sym" android:text="[" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="]" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="{" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="}" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="# " />
                <Button style="@style/KeyDark" android:tag="sym" android:text="&lt;" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="&gt;" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="|" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="\\" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="~" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dateimanager -->
        <LinearLayout
            android:id="@+id/file_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header-Zeile: "<" (zurück zum letzten Ordner) + Pfad + "▲" (nach oben) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/key_bg">

                <Button
                    android:id="@+id/btn_back_dir"
                    style="@style/KeyDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_back_label"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_up_dir"
                    style="@style/KeyDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_up_label"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_paste_dir"
                    style="@style/KeyDark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fm_paste"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/file_dir"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="start"
                    android:textColor="@color/text_primary"
                    android:padding="6dp" />
            </LinearLayout>

            <ListView
                android:id="@+id/file_list"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:background="@color/list_bg" />

            <TextView
                android:id="@+id/file_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </FrameLayout>

    <!-- Gemeinsame Funktionsleiste: ?123 / Space / Enter (nur bei abc/Notes sichtbar) -->
    <LinearLayout
        android:id="@+id/bottom_row"
        style="@style/KeyRow"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">
        <Button style="@style/KeyDark" android:id="@+id/key_toggle" android:text="\?123"
            android:textSize="16sp" />
        <Button style="@style/KeyDark" android:id="@+id/key_tab" android:text="⇥"
            android:layout_width="34dp" android:layout_weight="0" />
        <Button style="@style/KeyDark" android:id="@+id/key_space" android:text="@string/key_space_label"
            android:layout_weight="3" />
        <Button style="@style/KeyDark" android:id="@+id/key_dot" android:text="."
            android:layout_width="34dp" android:layout_weight="0" />
        <!-- Enter-Taste breiter: bekommt eigene Gewichtung statt Fix-Breite (besser drückbar) -->
        <Button style="@style/KeyDark" android:id="@+id/key_enter" android:text="@string/key_enter_label"
            android:layout_width="0dp" android:layout_weight="2" />
    </LinearLayout>
</LinearLayout>
