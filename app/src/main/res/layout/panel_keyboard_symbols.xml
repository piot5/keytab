            <LinearLayout style="@style/KeyRow">
                <Button style="@style/KeyDark" android:tag="sym" android:text="." />
                <Button style="@style/KeyDark" android:tag="sym" android:text="," />
                <Button style="@style/KeyDark" android:tag="sym" android:text="?" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="!" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="=" />
