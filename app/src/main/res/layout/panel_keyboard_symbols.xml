                <Button style="@style/KeyDark" android:tag="sym" android:text="3" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="4" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="5" />
                <Button style="@style/KeyDark" android:tag="sym" android:text="6" />
