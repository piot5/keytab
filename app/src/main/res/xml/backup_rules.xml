<?xml version="1.0" encoding="utf-8"?>
<!-- KeyTab sichert nichts (allowBackup="false"): für Android ≤ 11 (minSdk 24)
     schließt diese Regel alle Domänen aus. Pendant zu data_extraction_rules.xml
     (Android 12+), das Lint sonst als fehlend meldet. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
