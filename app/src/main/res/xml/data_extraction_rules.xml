<?xml version="1.0" encoding="utf-8"?>
<!-- KeyTab sichert nichts (allowBackup="false"): diese Regeln machen das für
     Android 12+ auch formal — kein Cloud-Backup, kein Geräte-Transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
