#!/bin/sh
# KeyTab — Schutz-Hook: verhindert Pushs, die die F-Droid-Auslieferung
# beschädigen könnten.
#
# Warum (Stand 2026-10-28: die App ist in F-Droid, 0.18.1 ist live; die
# Metadaten pflegt F-Droids `checkupdates`-Bot über MRs in `fdroid/fdroiddata`,
# gesteuert durch `AutoUpdateMode: Version` + `UpdateCheckMode: Tags`):
#   1. Ein NEUER Tag, während ein Metadaten-MR offen ist → der Reviewer pinnt
#      eine ältere Version als die neueste getaggte, die Runde fängt neu an
#      (genau das passierte direkt nach dem Merge von !50822 am 2026-10-22).
#   2. Ein FORCE-PUSH auf main → der im MR gepinnte Commit kann unerreichbar
#      werden, F-Droids Repro-Vergleich (`Binaries:`) schlägt dann fehl.
# Ein falsch gesetzter Tag war am 2026-10-28 die Ursache des gescheiterten
# 0.19-Updates: `v0.19` zeigte auf einen Commit mit versionName 0.20
# (GitHub Issue #1). Tags sind per Ruleset unveränderlich — deshalb lieber
# einmal zu viel blocken als einen kaputten Tag zu erzeugen.
#
# Ergänzend (serverseitig, greift auch ohne diesen Hook): GitHub-Rulesets
# „F-Droid-Schutz: Tags unveraenderlich" und „main: kein Force-Push, keine
# Loeschung" — siehe docs/RELEASE.md, Abschnitt „F-Droid-Kanal".
#
# Notausgänge (bewusst und einzeln):
#   KEYTAB_ALLOW_TAG_PUSH=1   git push --tags
#   KEYTAB_ALLOW_FORCE_PUSH=1 git push --force-with-lease
# Installation: sh scripts/install_git_hooks.sh
set -u

allow_tags="${KEYTAB_ALLOW_TAG_PUSH:-0}"
allow_force="${KEYTAB_ALLOW_FORCE_PUSH:-0}"
zero="0000000000000000000000000000000000000000"
rc=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_ref:-}" ] || continue

    # 1) Tags: Anlegen, Verschieben und Löschen blockieren.
    case "$remote_ref" in
        refs/tags/*)
            if [ "$allow_tags" != "1" ]; then
                printf 'ABGEBROCHEN: Push enthaelt Tag %s\n' "$remote_ref" >&2
                printf '  Ein neuer/verschobener Tag startet den Release-Workflow und\n' >&2
                printf '  laesst F-Droids checkupdates eine neuere Version sehen als die\n' >&2
                printf '  im offenen Metadaten-MR gepinnte (Review faengt neu an).\n' >&2
                printf '  Vorher pruefen: laeuft in fdroiddata ein MR zu com.piotv.keytab?\n' >&2
                printf '  Danach bewusst: KEYTAB_ALLOW_TAG_PUSH=1 git push origin vX.Y\n' >&2
                rc=1
            fi
            ;;
    esac

    # 2) Force-Push (Nicht-Fast-Forward) auf einen existierenden Ref blockieren.
    case "$local_sha" in "$zero") continue ;; esac
    case "$remote_sha" in "$zero") continue ;; esac
    # Nur pruefen, wenn wir den Remote-Stand lokal haben - sonst waere die
    # Vorfahren-Pruefung ein falscher Alarm.
    if git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
        if [ "$allow_force" != "1" ] && \
           ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
            printf 'ABGEBROCHEN: Push auf %s ist kein Fast-Forward.\n' "$remote_ref" >&2
            printf '  Der F-Droid-Build klont commit 135babd - die Historie muss bleiben.\n' >&2
            printf '  Falls wirklich gewollt: KEYTAB_ALLOW_FORCE_PUSH=1 git push --force-with-lease\n' >&2
            rc=1
        fi
    fi
done

[ "$rc" -eq 0 ] || printf '\nHinweis: Schutzregeln siehe docs/RELEASE.md, Abschnitt „F-Droid-Kanal".\n' >&2
exit "$rc"
